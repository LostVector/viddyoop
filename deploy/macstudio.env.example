# Copy with: python3 scripts/deploy.py init
# Use a registry digest, a CI sha-<commit> tag, or a locally verified image ID.
VIDDYOOP_IMAGE=SET_IMMUTABLE_IMAGE
VIDDYOOP_NAS_VOLUME=nas-public-temp
# The existing volume exposes Public, despite its name and prefixpath option.
VIDDYOOP_NAS_SUBPATH=temp/viddyoop-macstudio-20261117
VIDDYOOP_POSTGRES_PASSWORD_FILE=/absolute/private/postgres-password
VIDDYOOP_NAMESPACE=default
VIDDYOOP_HISTORY_RETENTION=30d
VIDDYOOP_PROFILE=apple-tv-hevc-v1
VIDDYOOP_ARCHIVE_POLICY=none
VIDDYOOP_ENCODE_WORKERS=1
VIDDYOOP_PREPROCESS_WORKERS=1
VIDDYOOP_PUBLISH_WORKERS=1
VIDDYOOP_PIPELINE_CPUSET=0-11
VIDDYOOP_PIPELINE_CPUS=12.0
VIDDYOOP_PIPELINE_MEMORY=10g
VIDDYOOP_MIN_FREE_BYTES=10737418240
VIDDYOOP_SCRATCH_MULTIPLIER=4
VIDDYOOP_SETTLE_MS=60000
VIDDYOOP_POLL_MS=5000
VIDDYOOP_TEMPORAL_PORT=0
