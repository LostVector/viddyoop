# Copy with: python3 scripts/deploy.py init
# Use a registry digest, a CI sha-<commit> tag, or a locally verified image ID.
VIDYOOP_IMAGE=SET_IMMUTABLE_IMAGE
VIDYOOP_NAS_VOLUME=nas-public-temp
# The existing volume exposes Public, despite its name and prefixpath option.
VIDYOOP_NAS_SUBPATH=temp/viddyoop-macstudio-20261117
VIDYOOP_POSTGRES_PASSWORD_FILE=/absolute/private/postgres-password
VIDYOOP_NAMESPACE=default
VIDYOOP_HISTORY_RETENTION=30d
VIDYOOP_PROFILE=apple-tv-hevc-v1
VIDYOOP_ARCHIVE_POLICY=none
VIDYOOP_ENCODE_WORKERS=1
VIDYOOP_PREPROCESS_WORKERS=1
VIDYOOP_PUBLISH_WORKERS=1
VIDYOOP_PIPELINE_CPUSET=0-11
VIDYOOP_PIPELINE_CPUS=12.0
VIDYOOP_PIPELINE_MEMORY=10g
VIDYOOP_MIN_FREE_BYTES=10737418240
VIDYOOP_SCRATCH_MULTIPLIER=4
VIDYOOP_SETTLE_MS=60000
VIDYOOP_POLL_MS=5000
VIDYOOP_TEMPORAL_PORT=0
